# Optional settings for gtasks-panel.
# Copy to ~/.config/gtasks-panel/config.ini and change what you need.
# Every key is optional. Values shown are the defaults.

[panel]
# Icon name from your icon theme. Empty = no icon.
icon = task-due
# Icon when at least one task is overdue. Empty = same as icon.
icon_overdue = task-past-due
# Text next to the icon. {count} is the number of open tasks.
label = {count}
# Command that runs on a panel click. gtasks-window shows the popup on
# one click and the full window on two clicks.
open_command = gtasks-window
# Seconds between two Google queries. Minimum 30.
refresh = 300
# Title of the task list a quick-add goes to, in the popup and the full
# window. A list you choose in the window always wins over this one.
# Empty = the chosen list, or the first list when All lists is chosen.
default_list =
