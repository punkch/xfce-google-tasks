#!/usr/bin/python3
"""Entry point of gtasks-panel. The code is in the gtasks_panel package.

The package sits beside this script in a checkout, and under
<prefix>/share/gtasks-panel after an install. Run with --help for the modes.
"""

import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
for candidate in (HERE.parent, HERE.parent / "share" / "gtasks-panel"):
    if (candidate / "gtasks_panel" / "__init__.py").exists():
        sys.path.insert(0, str(candidate))
        break

try:
    from gtasks_panel import panel
except Exception as exc:  # genmon must still get XML from the tick
    if len(sys.argv) > 1:
        raise
    from html import escape
    print(f"<txt>!</txt>\n<tool>{escape(f'gtasks-panel error: {exc}', quote=False)}</tool>")
    sys.exit(0)

sys.exit(panel.main(sys.argv[1:], entry=Path(__file__).resolve()))
