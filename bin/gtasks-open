#!/bin/bash
# gtasks-open: focus the Google Tasks app window, or open one.
#
# The window is a Chrome/Chromium "app" window with its own profile dir.
# The own profile dir is what makes --class work: a browser that already
# runs with the default profile would take over the URL and ignore it.
set -u

WIN_CLASS="${GTASKS_WIN_CLASS:-GoogleTasksApp}"
PROFILE_DIR="${GTASKS_PROFILE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/google-chrome-tasks-app}"
URL="https://tasks.google.com"

# wmctrl -a exits non-zero when no window matches the class.
wmctrl -x -a "$WIN_CLASS" 2>/dev/null && exit 0

# Detached from genmon: the panel must not wait for the browser.
for browser in google-chrome google-chrome-stable chromium chromium-browser; do
    if command -v "$browser" >/dev/null 2>&1; then
        setsid -f "$browser" \
            --app="$URL" \
            --class="$WIN_CLASS" \
            --user-data-dir="$PROFILE_DIR" \
            --no-first-run \
            >/dev/null 2>&1
        exit 0
    fi
done

echo "gtasks-open: no Chrome or Chromium found" >&2
exit 1
